{{define "zsh"}}#compdef {{.Name}}
{{range .Sets}}{{setFunction $.Name .ID}}() {
  local -a values
  values=({{range .Values}} {{quoteShell .}}{{end}})
{{with .Command}}  values+=("${(@f)$({{zshCommand .}} 2>/dev/null)}")
{{end}}  compadd -a values
}
{{end}}
_{{.Name}}() {
  local context=''
  local word
  local consume_value=0
  local options_done=0
  for word in ${words[2,$((CURRENT - 1))]}; do
    if (( consume_value )); then
      consume_value=0
      continue
    fi
    if (( options_done )); then
      continue
    fi
    if [[ "$word" == '--' ]]; then
      options_done=1
      continue
    fi
    case "$context:$word" in
{{range .ValueFlags}}{{$flag := .}}{{range .Names}}      '{{$flag.Context}}:{{.}}') consume_value=1; continue ;;
      '{{$flag.Context}}:{{.}}='*) continue ;;
{{end}}{{end}}    esac
    case "$context:$word" in
{{range .Transitions}}      '{{.From}}:{{.Word}}') context='{{.To}}' ;;
{{end}}    esac
  done
  case "$context" in
{{range .Commands}}    '{{.Context}}')
      _arguments \
{{range .Flags}}        '{{if .Short}}(-{{.Short}}){{end}}--{{.Name}}[{{zshText .Description}}]{{if .Value}}:value:{{with .ValueSet}}{{setFunction $.Name .}}{{end}}{{end}}' \
{{end}}{{if eq .Context "completion"}}        '{{.Position}}:shell:(bash zsh fish nu)'
{{else if .Subcommands}}{{with .ArgumentSet}}        '*:argument:{{setFunction $.Name .}}'
{{else}}        '{{.Position}}:command:({{join .Subcommands " "}})'
{{end}}
{{else}}{{with .ArgumentSet}}        '*:argument:{{setFunction $.Name .}}'
{{else}}        '*:argument:'
{{end}}
{{end}}      ;;
{{end}}  esac
}
compdef _{{.Name}} {{.Name}}{{end}}
